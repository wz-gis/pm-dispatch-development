{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-dispatch.local/context-packet.schema.json",
  "title": "PM Dispatch Context Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "derived",
    "mode",
    "task",
    "execution",
    "objective",
    "scope",
    "confirmed_facts",
    "open_failure",
    "open_blockers",
    "dependencies",
    "locks",
    "evidence_gaps",
    "verification_commands",
    "machine_snapshot",
    "recovery",
    "budgets",
    "source_digests",
    "generated_at",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1"]},
    "derived": {"type": "boolean", "enum": [true]},
    "mode": {"type": "string", "enum": ["initial", "continuation"]},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_version", "display_name", "title", "priority", "status", "area"],
      "properties": {
        "id": {"type": "string", "pattern": "^(BUG|SPEC|ONBOARD|RELEASE|ENV|CHORE)-[0-9]{3}$"},
        "schema_version": {"type": "string", "enum": ["3", "4"]},
        "display_name": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "status": {"type": "string", "minLength": 1},
        "area": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_status", "attempt_id", "attempt_status", "gate", "design_fingerprint", "latest_milestone"],
      "properties": {
        "run_id": {"type": ["string", "null"]},
        "run_status": {"type": ["string", "null"]},
        "attempt_id": {"type": ["string", "null"]},
        "attempt_status": {"type": ["string", "null"]},
        "gate": {"type": ["string", "null"], "enum": ["contract", "implementation", "integration", "verification", "closure", null]},
        "design_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "latest_milestone": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["progress_seq", "last_progress_at", "summary", "event_cursor"],
          "properties": {
            "progress_seq": {"type": "integer", "minimum": 0},
            "last_progress_at": {"type": ["string", "null"], "format": "date-time"},
            "summary": {"type": ["string", "null"]},
            "event_cursor": {"type": ["string", "null"]}
          }
        }
      }
    },
    "objective": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "prohibited", "constraints"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "status", "artifact_ids"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "pass_mock", "info"]},
          "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "open_failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["failure_class", "failure_phase", "diagnosis_status", "fingerprint", "repeat_count", "checkpoint_ref", "forbidden_retries", "next_diagnostic_action"],
      "properties": {
        "failure_class": {"type": "string", "minLength": 1},
        "failure_phase": {"type": "string", "minLength": 1},
        "diagnosis_status": {"type": "string", "enum": ["unknown", "diagnosing", "confirmed", "resolved"]},
        "fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "repeat_count": {"type": "integer", "minimum": 0},
        "checkpoint_ref": {"type": ["string", "null"]},
        "forbidden_retries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_diagnostic_action": {"type": ["string", "null"]}
      }
    },
    "open_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "cause", "hard", "description", "next_unblock_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "cause": {"type": "string", "minLength": 1},
          "hard": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1},
          "next_unblock_action": {"type": ["string", "null"]}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "required_status", "current_status", "evidence_ref"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^(BUG|SPEC|ONBOARD|RELEASE|ENV|CHORE)-[0-9]{3}$"},
          "required_status": {"type": "string", "minLength": 1},
          "current_status": {"type": ["string", "null"]},
          "evidence_ref": {"type": ["string", "null"]}
        }
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "mode", "status", "holder_run_id", "lease_expires_at", "scope"],
        "properties": {
          "resource_id": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "enum": ["shared", "exclusive"]},
          "status": {"type": "string", "enum": ["active", "released", "expired"]},
          "holder_run_id": {"type": "string", "minLength": 1},
          "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
          "scope": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_commands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "machine_snapshot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["git_head", "branch", "dirty_paths", "scanned_files", "focus"],
      "properties": {
        "git_head": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "dirty_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scanned_files": {"type": "integer", "minimum": 0},
        "focus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "state", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "state": {"type": "string", "enum": ["file", "directory", "missing"]},
              "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "recovery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["gate", "state", "failure_fingerprint", "failed_attempt_count", "failed_paths", "remaining_paths", "next_action"],
      "properties": {
        "gate": {"type": "string", "enum": ["contract", "implementation", "integration", "verification", "closure"]},
        "state": {"type": "string", "enum": ["closed", "open"]},
        "failure_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "failed_attempt_count": {"type": "integer", "minimum": 0},
        "failed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "remaining_paths": {"type": "integer", "minimum": 0},
        "next_action": {"type": ["string", "null"]}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_max_chars", "initial_prompt_max_chars", "continuation_prompt_max_chars", "full_read_allowed", "full_read_trigger", "full_read_triggers"],
      "properties": {
        "packet_max_chars": {"type": "integer", "minimum": 1000, "maximum": 16000},
        "initial_prompt_max_chars": {"type": "integer", "minimum": 1000, "maximum": 12000},
        "continuation_prompt_max_chars": {"type": "integer", "minimum": 500, "maximum": 3000},
        "full_read_allowed": {"type": "boolean"},
        "full_read_trigger": {
          "type": ["string", "null"],
          "enum": ["design-freeze-change", "safety-boundary-change", "contract-review", "schema-migration", "terminal-closure", "forensic-diagnosis", null]
        },
        "full_read_triggers": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["design-freeze-change", "safety-boundary-change", "contract-review", "schema-migration", "terminal-closure", "forensic-diagnosis"]}
        }
      }
    },
    "source_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "runtime", "evidence", "evidence_digest", "project_snapshot", "recovery_ledger"],
      "properties": {
        "task": {"$ref": "#/$defs/source_digest"},
        "runtime": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "evidence": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "evidence_digest": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "project_snapshot": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "recovery_ledger": {"type": ["object", "null"], "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "packet_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "source_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
