{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-dispatch.local/evidence-digest.schema.json",
  "title": "PM Dispatch Evidence Digest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "derived",
    "task_id",
    "current_state",
    "confirmed_facts",
    "quality_checks",
    "artifact_index",
    "open_blockers",
    "audit",
    "budget",
    "source_digest",
    "generated_at",
    "digest_sha256"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1"]},
    "derived": {"type": "boolean", "enum": [true]},
    "task_id": {"type": "string", "pattern": "^(BUG|SPEC|ONBOARD|RELEASE|ENV|CHORE)-[0-9]{3}$"},
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion_status", "evidence_level", "real_chain_verified", "changed_surface", "uncovered_items", "run_id", "attempt_id", "run_status"],
      "properties": {
        "conclusion_status": {"type": "string", "minLength": 1},
        "evidence_level": {"type": "string", "enum": ["NONE", "L0", "L1", "L2", "L3", "L4"]},
        "real_chain_verified": {"type": "boolean"},
        "changed_surface": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "uncovered_items": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "run_id": {"type": ["string", "null"]},
        "attempt_id": {"type": ["string", "null"]},
        "run_status": {"type": ["string", "null"]}
      }
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "status", "artifact_ids"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "pass_mock"]},
          "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary", "evidence_refs", "checked_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pending", "passed", "failed", "skipped", "blocked"]},
          "summary": {"type": "string"},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "checked_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "artifact_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "result", "evidence_ref", "digest"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["pass", "fail", "info"]},
          "evidence_ref": {"type": "string", "minLength": 1},
          "digest": {"type": ["string", "null"]}
        }
      }
    },
    "open_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_count", "omitted_run_count", "recent_runs"],
      "properties": {
        "run_count": {"type": "integer", "minimum": 0},
        "omitted_run_count": {"type": "integer", "minimum": 0},
        "recent_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "attempt_id", "status", "commit"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1},
              "attempt_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "commit": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_chars"],
      "properties": {"max_chars": {"type": "integer", "minimum": 1000, "maximum": 12000}}
    },
    "source_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "digest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
